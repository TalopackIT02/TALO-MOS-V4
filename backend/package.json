{
  "name": "talo-mos-v4-backend",
  "private": true,
  "version": "0.0.0",
  "description": "TALO-MOS-V4 backend (Node.js + TypeScript + Express)",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:local": "node --env-file-if-exists=../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke:db": "tsx --env-file-if-exists=../.env test/smoke/db-runtime.smoke.ts",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "provision:account": "tsx --env-file-if-exists=../.env src/modules/auth/provisioning/cli.ts",
    "pwned:manifest": "tsx src/modules/auth/tools/pwnedManifest.ts create",
    "pwned:verify": "tsx src/modules/auth/tools/pwnedManifest.ts verify",
    "pwned:compact": "tsx src/modules/auth/tools/pwnedCompact.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/supertest": "7.2.1",
    "prisma": "7.10.0",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
