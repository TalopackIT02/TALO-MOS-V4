
# TALO-MOS-V4 — Development Environment Template
# Example values only. Never store real passwords here.

# PostgreSQL Docker
POSTGRES_USER=talo_dev
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=talo_mos_v4_dev
POSTGRES_PORT=5432

# Backend (backend/src/config/env.ts). Empty values fall back to the defaults shown in comments.
# NODE_ENV: development | test | production
NODE_ENV=development
# HOST/PORT the backend binds to (default 127.0.0.1:3000). Behind the future reverse proxy keep it private.
HOST=127.0.0.1
PORT=3000
# Allowed browser origins for state-changing requests (comma-separated, bare origins). Required in production.
APP_ORIGIN=http://127.0.0.1:5173
# Reverse-proxy trust: false (default), a hop count such as 1, or proxy addresses/subnets. "true" is rejected.
TRUST_PROXY=false
# debug | info | warn | error
LOG_LEVEL=info

# Prisma / PostgreSQL. Optional for the Foundation (health check does not use the database).
# From the Windows host the Docker database is reached on the published port (local setup: 5433).
# The application must use the least-privilege role (talo_app), never a superuser.
DATABASE_URL=postgresql://<app_user>:<app_password>@127.0.0.1:<port>/<database>

# Existing application settings
FRONTEND_API_URL=
